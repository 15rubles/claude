rules_version = '2';

// Security rules for the costume contest.
// BEFORE PUBLISHING: replace CHANGE-ME-HOST-PASSWORD below with your own host password.
// Pick a phrase, not a 4-digit code (e.g. "pumpkin-guts-at-midnight"). Don't commit the real one.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isHost() { return signedIn() && exists(/databases/$(database)/documents/hosts/$(me())); }

    // A device becomes a host by writing the correct password here.
    match /hosts/{uid} {
      allow get: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin == 'CHANGE-ME-HOST-PASSWORD';
    }

    // Host-only: the winner reveal. The TV reads it.
    match /config/state {
      allow read: if true;
      allow write: if isHost();
    }

    // One vote per phone (document id = the phone's anonymous user id): the name the guest typed.
    // The TV counts them and the host tallies them, so any signed-in device can read them.
    match /votes/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.at == request.time;
      allow delete: if isHost();
    }
  }
}
